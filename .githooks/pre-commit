#!/bin/sh

for file in $(git diff --cached --name-only --diff-filter=ACM); do

    # Skip the hook's own source file
    case "$file" in
        .githooks/pre-commit) continue ;;
    esac

    if git show ":$file" | grep -nE 'TODO|FIXME'; then
        echo "ERROR: Commit blocked!"
        echo "Remove TODO or FIXME from: $file"
        exit 1
    fi
done

echo "Pre-commit check passed!"
exit 0